# ==============================================================================
# EDVORA ENVIRONMENT CONFIGURATION (.env / .env.local)
# Copy this file to .env.local or .env for local development
# NEVER commit your .env or .env.local file with real credentials to Git!
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (from Project Settings -> API -> Project API keys)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google reCAPTCHA v2 / v3 Public Site Key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Optional: Groq AI API Key for Edvora AI Chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

